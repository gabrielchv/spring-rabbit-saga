{
  "info": {
    "name": "spring-rabbit-saga",
    "description": "Choreographed saga: POST /orders -> order.created -> payment -> inventory -> order.completed",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create order (happy path)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('accepted (2xx)', () => pm.response.code >= 200 && pm.response.code < 300);",
              "const body = pm.response.json();",
              "pm.test('has order id', () => pm.expect(body.id).to.be.a('string'));",
              "pm.test('status is CREATED', () => pm.expect(body.status).to.eql('CREATED'));",
              "pm.collectionVariables.set('orderId', body.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"customer-1\",\n  \"amount\": 150.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create order above payment limit (compensation path)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('accepted (2xx)', () => pm.response.code >= 200 && pm.response.code < 300);",
              "pm.collectionVariables.set('declinedOrderId', pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"customer-2\",\n  \"amount\": 20000.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get order by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('2xx', () => pm.response.code >= 200 && pm.response.code < 300);",
              "pm.test('has a terminal status', () => ['COMPLETED','FAILED','CREATED'].includes(pm.response.json().status));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{orderId}}"
          ]
        }
      },
      "response": []
    }
  ]
}
